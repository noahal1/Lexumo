migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Gradle's own build cache: lock files, last-build timestamps and hashes. It is
# machine state that regenerates on the next build, so committing it only adds
# churn. Deliberately unanchored — the vendored plugin under third_party/ has an
# android/ directory of its own, and that is where these files came from.
.gradle/

# Widget Preview related
.widget_preview/

# Screenshots taken off the emulator by tool/shots_mobile.sh. They are evidence
# for a given build, not source, and the directory grows by a few MB each run.
/.shots/

# Release APKs copied out of build/ by tool/build_apk.sh. 20-50 MB of binary
# that is reproducible from source with one command.
/dist/

