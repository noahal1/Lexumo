{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lexumo",
  "version": "0.1.0",
  "identifier": "com.lexumo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lexumo · 词砚",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "A calm desktop vocabulary studio",
    "longDescription": "Lexumo（词砚）是一个安静的桌面背单词工作室：词库管理、间隔重复复习、测验、统计与双语界面。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
